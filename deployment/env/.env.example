# Runtime
YLVEN_ENV=staging
YLVEN_PUBLIC_BASE_URL=https://api.orbexa.cc
YLVEN_AUTH_BASE_URL=https://auth.orbexa.cc
YLVEN_ADMIN_BASE_URL=https://admin.orbexa.cc
YLVEN_DEVELOPER_BASE_URL=https://developer.orbexa.cc
YLVEN_GATEWAY_BASE_URL=https://gateway.orbexa.cc
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# PostgreSQL / Redis / NATS (real secrets injected separately)
DATABASE_URL=postgres://ylven:${POSTGRES_PASSWORD}@postgres:5432/ylven?sslmode=disable
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
NATS_URL=nats://${NATS_USER}:${NATS_PASSWORD}@nats:4222

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_REF=secret://ylven/staging/turnstile
TURNSTILE_EXPECTED_HOSTNAME=auth.orbexa.cc

# Email
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=no-reply@orbexa.cc
EMAIL_FROM_NAME=YLVEN
EMAIL_SECRET_REF=secret://ylven/staging/email

# R2
R2_ACCOUNT_ID=
R2_BUCKET_UPLOADS=ylven-staging-uploads
R2_BUCKET_ARTIFACTS=ylven-staging-artifacts
R2_ENDPOINT=
R2_ACCESS_KEY_REF=secret://ylven/staging/r2/access-key
R2_SECRET_KEY_REF=secret://ylven/staging/r2/secret-key
R2_FILES_PUBLIC_BASE=https://files.orbexa.cc
R2_ASSETS_PUBLIC_BASE=https://assets.orbexa.cc

# Sub2API test gateway
SUB2API_ENVIRONMENT=TEST
SUB2API_CHANNEL_TYPE=SUBSCRIPTION_PROXY
SUB2API_BASE_URL=https://sub2api.orbexa.cc
SUB2API_ADMIN_SECRET_REF=secret://ylven/staging/sub2api/admin

# Provider official channels are disabled until configured
OPENAI_CHANNEL_ENABLED=false
ANTHROPIC_CHANNEL_ENABLED=false
XAI_CHANNEL_ENABLED=false
OPENAI_SECRET_REF=secret://ylven/production/openai
ANTHROPIC_SECRET_REF=secret://ylven/production/anthropic
XAI_SECRET_REF=secret://ylven/production/xai
